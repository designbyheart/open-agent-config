#!/usr/bin/env sh
#
# Copilot-style PR review on push, powered by Claude Code (headless).
# Installed globally via:  git config --global core.hooksPath ~/.config/git/hooks
#
# This is the GLOBAL wrapper. It runs for every repo whose effective
# core.hooksPath is this directory (i.e. repos WITHOUT a local override such
# as husky). The actual review lives in the sibling `pr-review-run` script so
# husky repos can call the body directly without looping back through this
# delegating wrapper.
#
# Behavior: runs the /pr-review skill on the diff being pushed; BLOCKS the push
# (exit 1) only when the review emits "VERDICT: BLOCK".
#
# Bypass:  git push --no-verify        (skip all hooks)
#     or:  SKIP_PR_REVIEW=1 git push   (skip just this review)

set -u

# --- 0. delegate to repo-local hook, if any -------------------------------
# A global core.hooksPath overrides each repo's .git/hooks, so give a real
# repo-local pre-push a chance to run first and keep working.
git_dir=$(git rev-parse --git-path hooks 2>/dev/null)
local_hook="$git_dir/pre-push"
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
if [ -n "${git_dir:-}" ] && [ -x "$local_hook" ] && [ "$local_hook" != "$self" ]; then
  "$local_hook" "$@" || exit $?
fi

# --- 1. run the shared review body ----------------------------------------
exec "$(dirname "$0")/pr-review-run" "$@"
